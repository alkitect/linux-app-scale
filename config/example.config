# linux-app-scale global config
# Copy to ~/.config/linux-app-scale/config (install-to-local.sh seeds this file).

# Default scale for profiles that omit SCALE=. Leave unset and pass --scale on add.
# Common HiDPI values: 1.25, 1.5, 2.0 — do not guess; a wrong scale is worse than none.
# DEVICE_SCALE_FACTOR=

# Absolute path to app-scale-managed after install
# APP_SCALE_MANAGED_PATH=
